{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "typeRoots": ["./node_modules/@types", "./types"],
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
