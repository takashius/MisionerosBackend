# MongoDB
BD_URL=mongodb://localhost:27017/misioneros
BD_ATLAS_URL=
MONGO_DEBUG=true

# Server
PORT=3040
HOST=http://localhost
NODE_ENV=development
PUBLIC_ROUTE=/public
FILES_ROUTE=/files

# JWT (obligatorio en staging y producción)
JWT_KEY=cambia-esta-clave-en-produccion

# CORS
CORS_ORIGINS=http://localhost:3050
CORS_ORIGIN_SUFFIXES=.localhost

# URL pública del frontend (enlaces del pase en correos)
PUBLIC_APP_URL=http://localhost:3050

# Super admin inicial (se crea al arrancar si no existe ningún SUPER_ADMIN)
USER_ADMIN_EMAIL=admin@misioneros.local
USER_ADMIN_PASSWORD=cambia-esta-clave
USER_ADMIN_NAME=Administrador

# Mailjet (mismo servicio que EduGestion)
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAIL_FROM_EMAIL=envios@edugestion.site
MAIL_FROM_NAME=Misioneros

# Branding de correos (misma forma que company.configMail de EduGestion)
MAIL_BRAND_NAME=Misioneros
MAIL_BRAND_EMAIL=contacto@misioneros.local
MAIL_BRAND_PHONE=
MAIL_BRAND_LOGO=
MAIL_BRAND_BANNER=
MAIL_COLOR_PRIMARY=#008080
MAIL_COLOR_SECONDARY=#8CF7FC
MAIL_COLOR_BACKGROUND=#2a2a2a
MAIL_COLOR_TITLE=#ffffff

# Cloudinary (mismo servicio que EduGestion)
CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
FOLDER_NAME=misioneros
